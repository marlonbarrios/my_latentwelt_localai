# Local model server. Ollama must already be running.
OLLAMA_HOST=http://127.0.0.1:11434

# Any model you have pulled. Examples: gemma4, gemma3, qwen3, deepseek-r1
OLLAMA_MODEL=gemma4

# Gemma 4 and other reasoning models think before they answer.
# Set this to false for a model that should answer directly.
OLLAMA_THINK=true

# The Latentwelt system prompt is long. 16384 tokens leaves room for it.
# OLLAMA_NUM_CTX=16384
